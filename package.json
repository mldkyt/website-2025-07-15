{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nodemon -e prisma --exec \"npm run actual:dev\"",
    "build": "next build",
    "start": "npm run db:push && npm run start:2",
    "start:2": "next start",
    "lint": "next lint",
    "db:push": "npx prisma db push",
    "db:generate": "npx prisma generate",
    "actual:dev": "npm run db:generate && npm run db:push && next dev -p 8000"
  },
